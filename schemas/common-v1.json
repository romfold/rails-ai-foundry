{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.rails-ai-foundry.invalid/common-v1.json",
  "definitions": {
    "envelope": {
      "type": "object",
      "properties": {
        "report_schema": {
          "type": "integer",
          "const": 1
        },
        "foundry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][A-Za-z0-9.-]+)?$"
        },
        "report_kind": {
          "type": "string"
        }
      },
      "required": [
        "report_schema",
        "foundry_version",
        "report_kind"
      ],
      "additionalProperties": true
    },
    "identity": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "command": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_status": {
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "stdout",
        "stderr",
        "exit_status"
      ],
      "additionalProperties": true
    }
  }
}
