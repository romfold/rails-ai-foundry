<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Voice control and media</title></head>
<body>
  <main>
    <h1>Voice control and media</h1>
    <p>Choose a short speech recording. This local demo sends PCM frames through the separate media endpoint and plays them back. No model or speech provider is called.</p>
    <label>Tenant token <input id="token" type="password" value="demo-a" autocomplete="off"></label>
    <label>Speech recording <input id="recording" type="file" accept="audio/*"></label>
    <button id="play">Start turn and play</button>
    <button id="interrupt">Interrupt</button>
    <button id="reconnect">Reconnect</button>
    <p role="status" id="status">Ready. Control delivery can be processed separately with bin/control.</p>
  </main>
<script>
(() => {
  let session, epoch = 0, generation = 0, audio, changing = false;
  const status = document.querySelector('#status');
  async function request(path, method = 'GET', body) {
    const response = await fetch(path, {
      method, headers: { 'Authorization': `Bearer ${document.querySelector('#token').value}`, 'Content-Type': 'application/json' },
      body: body && JSON.stringify(body)
    });
    if (!response.ok) throw new Error(`Request failed: ${response.status}`);
    return response.json();
  }
  async function control(action) {
    if (changing) throw new Error('A control change is already in progress.');
    changing = true;
    try {
      generation += 1;
      if (audio) { await audio.close(); audio = null; }
      if (!session) session = (await request('/sessions', 'POST', {})).id;
      const state = await request(`/sessions/${session}/control`, 'POST', { action_name: action });
      epoch = state.epoch;
      status.textContent = `${action}: epoch ${epoch}`;
      return generation;
    } finally { changing = false; }
  }
  function encode(samples) {
    const data = new DataView(new ArrayBuffer(samples.length * 2));
    samples.forEach((sample, i) => data.setInt16(i * 2, Math.max(-32768, Math.min(32767, sample * 32767)), true));
    return btoa(String.fromCharCode(...new Uint8Array(data.buffer)));
  }
  async function play() {
    const file = document.querySelector('#recording').files[0];
    if (!file || file.size > 5000000) throw new Error('Choose an audio file smaller than 5 MB.');
    const turn = await control('turn');
    const turnEpoch = epoch;
    const turnSession = session;
    audio = new AudioContext({ sampleRate: 24000 });
    const context = audio;
    const decoded = await context.decodeAudioData(await file.arrayBuffer());
    const samples = decoded.getChannelData(0);
    for (let offset = 0, sequence = 0; offset < samples.length && turn === generation; offset += 960, sequence += 1) {
      const data = encode(samples.subarray(offset, offset + 960));
      await request(`/sessions/${turnSession}/media`, 'POST', { epoch: turnEpoch, sequence, data });
      const frame = await request(`/sessions/${turnSession}/media?epoch=${turnEpoch}`);
      if (turn !== generation || !frame.data) break;
      const bytes = Uint8Array.from(atob(frame.data), char => char.charCodeAt(0));
      const pcm = new DataView(bytes.buffer);
      const buffer = context.createBuffer(1, bytes.length / 2, 24000);
      const channel = buffer.getChannelData(0);
      for (let i = 0; i < channel.length; i++) channel[i] = pcm.getInt16(i * 2, true) / 32768;
      const source = context.createBufferSource();
      source.buffer = buffer;
      source.connect(context.destination);
      source.start();
      await new Promise(resolve => setTimeout(resolve, buffer.duration * 1000));
    }
    if (turn === generation) status.textContent = `Playback complete: epoch ${epoch}`;
  }
  for (const [id, action] of [['play', play], ['interrupt', () => control('interrupt')], ['reconnect', () => control('reconnect')]]) {
    document.querySelector(`#${id}`).addEventListener('click', () => action().catch(error => { status.textContent = error.message; }));
  }
})();
</script>
</body>
</html>
