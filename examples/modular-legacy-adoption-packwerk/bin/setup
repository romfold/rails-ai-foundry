#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
Dir.chdir(File.expand_path('..', __dir__)) do
  FileUtils.mkdir_p(%w[storage log tmp])
  system('bundle', 'check', exception: true)
  system('bin/rails', 'db:prepare', exception: true)
  system('bin/rails', 'db:seed', exception: true)
end
