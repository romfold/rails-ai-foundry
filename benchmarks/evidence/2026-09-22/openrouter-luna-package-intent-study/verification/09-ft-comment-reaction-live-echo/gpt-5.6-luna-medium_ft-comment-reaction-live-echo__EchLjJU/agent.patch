diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..b66732b
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,19 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).order(:created_at).each do |reaction| %>
+      <div class="reaction reaction--deleteable" data-reaction-creator-id="<%= reaction.creator_id %>" data-action="click->reaction#toggleDelete" title="<%= reaction.creator.name %>">
+        <%= avatar_tag reaction.creator, hidden_for_screen_reader: true, class: "reaction__avatar" %>
+        <span class="txt-small txt-medium overflow-ellipsis"><%= reaction.body %></span>
+        <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete, class: "reaction__delete btn btn--circle borderless" do %>
+          <%= icon_tag "close" %><span class="for-screen-reader">Remove reaction</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="reaction#open" aria-label="Add a reaction"><%= image_tag "boost-color.svg", alt: "" %></button>
+  <%= form_with model: [comment.card, comment, Reaction.new], class: "reaction reaction__form", hidden: true, data: { reaction_target: "form", action: "submit->reaction#submit" } do |form| %>
+    <%= form.text_field :body, class: "reaction__input input", maxlength: 16, autocomplete: "off", aria: { label: "Reaction" }, data: { reaction_target: "input" } %>
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless" do %><%= icon_tag "check" %><span class="for-screen-reader">Confirm</span><% end %>
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction#close"><%= icon_tag "close" %><span class="for-screen-reader">Cancel</span></button>
+  <% end %>
+</div>
