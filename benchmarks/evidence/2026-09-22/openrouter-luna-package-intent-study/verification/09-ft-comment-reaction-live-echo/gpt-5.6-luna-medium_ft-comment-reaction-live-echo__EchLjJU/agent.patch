+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params)
+    render_reactions
+  end
+
+  def destroy
+    return head :forbidden unless @reaction.creator == Current.user
+    @reaction.destroy!
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :body ])
+    end
+
+    def render_reactions
+      render turbo_stream: turbo_stream.replace(dom_id(@comment, :reactions), partial: "cards/comments/reactions", locals: { comment: @comment.reload })
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..4353a04
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["trigger", "form", "input"]
+
+  connect() {
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    this.element.querySelectorAll("[data-reaction-creator-id]").forEach((reaction) => {
+      if (reaction.dataset.reactionCreatorId !== currentUserId) {
+        reaction.classList.remove("reaction--deleteable")
+        reaction.querySelector(".reaction__delete")?.remove()
+      }
+    })
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.reset()
+    this.triggerTarget.hidden = false
+  }
+
+  submit(event) {
+    if (!this.inputTarget.value.trim()) event.preventDefault()
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest("button")) return
+    event.currentTarget.classList.toggle("expanded")
+  }
+}
