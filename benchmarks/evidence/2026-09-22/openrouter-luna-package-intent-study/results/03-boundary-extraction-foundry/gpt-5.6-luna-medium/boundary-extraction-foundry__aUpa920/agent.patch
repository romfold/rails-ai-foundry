@@ -0,0 +1,28 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  def test_catalog_returns_only_published_documents_in_id_order
+    later = document(body: 'later')
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+
+    assert_equal [later.id, earlier.id].sort, Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], Knowledge::Catalog.list(tenant_id: 'a').first.keys
+  end
+
+  def test_catalog_is_tenant_scoped
+    document(body: 'a document')
+    document(tenant: 'b', body: 'b document')
+
+    assert_equal ['a document'], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('body') }
+  end
+
+  def test_delivery_uses_the_knowledge_catalog_boundary
+    source = File.read(Rails.root.join('app/controllers/documents_controller.rb'))
+
+    refute_includes source, 'Knowledge::Document'
+    assert_includes source, 'Knowledge::Catalog.list'
+  end
+end
