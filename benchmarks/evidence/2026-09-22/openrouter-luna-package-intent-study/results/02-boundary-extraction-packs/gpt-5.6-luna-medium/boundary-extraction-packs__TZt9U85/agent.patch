@@ -0,0 +1,37 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_documents_in_id_order
+    later = document(body: 'later')
+    document(body: 'hidden', published: false)
+    earlier = document(body: 'earlier')
+
+    assert_equal [later.id, earlier.id], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], Knowledge::Catalog.list(tenant_id: 'a').first.keys
+  end
+
+  def test_delivery_delegates_to_catalog
+    calls = []
+    original = Knowledge::Catalog.method(:list)
+    Knowledge::Catalog.define_singleton_method(:list) do |tenant_id:|
+      calls << tenant_id
+      [{ 'id' => 7, 'tenant_id' => tenant_id, 'body' => 'from catalog', 'revision' => 2 }]
+    end
+
+    get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+
+    assert_equal 200, last_response.status
+    assert_equal 'from catalog', JSON.parse(last_response.body).first.fetch('body')
+    assert_equal ['a'], calls
+  ensure
+    Knowledge::Catalog.define_singleton_method(:list, &original)
+  end
+end
