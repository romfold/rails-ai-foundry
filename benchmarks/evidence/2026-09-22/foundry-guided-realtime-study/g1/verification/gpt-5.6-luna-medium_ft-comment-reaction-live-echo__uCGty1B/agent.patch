diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..6081a05
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,26 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).each do |reaction| %>
+      <div class="reaction reaction--deleteable" data-controller="toggle-class" data-toggle-class-toggle-class="expanded" data-action="click->toggle-class#toggle" data-creator-id="<%= reaction.creator_id %>" title="<%= reaction.creator.name %>">
+        <%= avatar_tag reaction.creator, class: "reaction__avatar", hidden_for_screen_reader: true %>
+        <span class="txt-small txt-medium"><%= reaction.content %></span>
+        <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete, class: "reaction__delete btn btn--plain", data: { only_visible_to_you: true } do %>
+          <%= icon_tag "close" %><span class="for-screen-reader">Remove reaction</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="reaction reaction__form" data-reactions-target="form" hidden>
+    <%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction, data: { controller: "form", action: "submit->form#preventEmptySubmit" } do |form| %>
+      <%= form.label :content, "Add a reaction", class: "reaction__form-label for-screen-reader" %>
+      <%= form.text_field :content, class: "reaction__input input", data: { reactions_target: "input" }, maxlength: 16, autocomplete: "off", placeholder: "React…", required: true %>
+      <%= button_tag type: :submit, class: "reaction__submit-btn reaction__submit-btn btn btn--plain", aria: { label: "Confirm reaction" } do %><%= icon_tag "check" %><% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--plain" data-action="reactions#cancel" aria-label="Cancel reaction"><%= icon_tag "close" %></button>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#open" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+</div>
