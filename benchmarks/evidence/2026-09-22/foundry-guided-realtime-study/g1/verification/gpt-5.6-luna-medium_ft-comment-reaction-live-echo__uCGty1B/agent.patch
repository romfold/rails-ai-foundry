diff --git a/test/controllers/cards/comments_controller_test.rb b/test/controllers/cards/comments_controller_test.rb
index 94eb710..a45ff1b 100644
--- a/test/controllers/cards/comments_controller_test.rb
+++ b/test/controllers/cards/comments_controller_test.rb
@@ -146,3 +146,32 @@ class Cards::CommentsControllerTest < ActionDispatch::IntegrationTest
     assert_not Comment.exists?(comment.id)
   end
 end
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create reaction" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+    assert_response :success
+    assert_equal "👍", @comment.reactions.last.content
+  end
+
+  test "reaction is limited to sixteen characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "12345678901234567" } }, as: :turbo_stream
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "cannot remove another user's reaction" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "👏")
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+end
