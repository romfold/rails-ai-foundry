+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reaction_owner, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params)
+    render_reactions
+  end
+
+  def destroy
+    @reaction.destroy
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reaction_owner
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      respond_to do |format|
+        format.turbo_stream { render turbo_stream: turbo_stream.replace([ @comment, :reactions ], partial: "cards/comments/reactions", locals: { comment: @comment }) }
+        format.json { render "cards/comments/reactions", status: :created }
+      end
+    end
+end
