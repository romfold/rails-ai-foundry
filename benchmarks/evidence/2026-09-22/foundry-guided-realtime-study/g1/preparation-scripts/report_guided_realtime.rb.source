# frozen_string_literal: true

require File.expand_path('benchmarks/lib/benchmark_suite/openrouter_account',
                         ENV.fetch('BENCHMARK_REPOSITORY', Dir.pwd))
require File.expand_path('benchmarks/lib/benchmark_suite/evidence', ENV.fetch('BENCHMARK_REPOSITORY', Dir.pwd))

root = Pathname(ARGV.fetch(0)).realpath
output = ARGV.fetch(1)
cycle = Pathname('/private/tmp/foundry-fix-retest-cycle-20260922')
manifest = JSON.parse(root.join('treatment.json').read)
unless manifest.fetch('frozen_suite_files') == BenchmarkSuite::Support.files(root.join('suite'))
  abort 'Frozen treatment changed'
end
paths = root.glob('results/**/result.json')
abort 'Expected one native attempt' unless paths.size == 1
native_path = paths.first
native = JSON.parse(native_path.read)
expected = [manifest.fetch('task'), 'miniswen', manifest.fetch('model'),
            manifest.fetch('task_digest'), manifest.fetch('profile_digest')]
abort 'Native identity mismatch' unless native.values_at('task', 'agent', 'model', 'task_digest',
                                                         'profile_digest') == expected
summary = JSON.parse(root.join('verification/summary.json').read)
abort 'Expected one independent assessment' unless summary.fetch('records').size == 1
summary.fetch('native_files').each do |relative, hash|
  abort 'Native artifacts changed' unless Digest::SHA256.file(root.join('results', relative)).hexdigest == hash
end
initial = JSON.parse(cycle.join('initial-accounting.json').read)
preflight = JSON.parse(root.join('preflight/preflight.json').read)
snapshot = BenchmarkSuite::OpenrouterAccount.new.snapshot
abort 'Provider key changed' unless initial.fetch('key_fingerprint') == snapshot.fetch('key_fingerprint')
cost = native.dig('usage', 'cost_usd')
known_cost = cost.is_a?(Numeric) && cost.finite? && cost >= 0
account = snapshot.fetch('account')
usage = account['usage']
known_usage = usage.is_a?(Numeric) && usage.finite? && usage >= initial.dig('account', 'usage')
cycle_delta = known_usage ? (usage - initial.dig('account', 'usage')).round(8) : nil
trial_delta = known_usage ? (usage - preflight.dig('snapshot', 'account', 'usage')).round(8) : nil
prior = preflight.fetch('cycle_accounting').fetch('reported_cost')
total = known_cost ? (prior + cost).round(8) : nil
conservative = total && cycle_delta ? [total, cycle_delta].max : nil
accounting = { 'reported_trial_cost' => known_cost ? cost : nil, 'reported_cycle_cost' => total,
               'provider_trial_delta' => trial_delta, 'provider_cycle_delta' => cycle_delta,
               'conservative_cycle_spend' => conservative,
               'cycle_remaining' => conservative ? (7.0 - conservative).round(8) : nil,
               'provider_confirmed' => known_cost && known_usage && cost.round(8) == trial_delta,
               'snapshot' => snapshot }
result = { 'treatment' => manifest.fetch('treatment'), 'native' => native,
           'native_result_sha256' => Digest::SHA256.file(native_path).hexdigest,
           'independent' => summary.fetch('records').first, 'accounting' => accounting,
           'manifest_sha256' => Digest::SHA256.file(root.join('treatment.json')).hexdigest,
           'original_cohort' => '9 native passes / 1 failure; unchanged by this separate treatment' }
evidence = BenchmarkSuite::Evidence.new(output)
evidence.json('report.json', result)
puts JSON.pretty_generate(result)
