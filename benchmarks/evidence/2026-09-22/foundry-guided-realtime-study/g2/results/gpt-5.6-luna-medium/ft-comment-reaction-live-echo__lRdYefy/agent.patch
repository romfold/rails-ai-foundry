new file mode 100644
index 0000000..49a0448
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,24 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+
+  def create
+    @comment.reactions.create!(reaction_params.merge(account: Current.account, creator: Current.user))
+    head :no_content
+  end
+
+  def destroy
+    @comment.reactions.find_by!(creator: Current.user).destroy
+    head :no_content
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :body ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..2c1e086
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["form", "input"]
+
+  connect() { this.close() }
+
+  open() {
+    this.formTarget.classList.add("expanded")
+    this.formTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest("button")) return
+    event.currentTarget.classList.toggle("expanded")
+  }
+
+  stop(event) { event.stopPropagation() }
+
+  close() {
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    if (this.hasInputTarget) this.inputTarget.value = ""
+  }
+}
