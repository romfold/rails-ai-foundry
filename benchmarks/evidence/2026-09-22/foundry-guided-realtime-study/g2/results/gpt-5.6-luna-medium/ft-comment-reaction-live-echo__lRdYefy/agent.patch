diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..ed964bf
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,24 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction-form">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).order(:created_at).each do |reaction| %>
+      <div class="reaction reaction--deleteable" data-action="click->reaction-form#toggleDelete" data-creator-id="<%= reaction.creator_id %>" title="<%= reaction.creator.name %>">
+        <span class="txt-small txt-medium"><%= reaction.body %></span>
+        <%= button_to card_comment_reaction_path(comment.card, comment), method: :delete,
+              class: "reaction__delete btn btn--plain", data: { only_visible_to_you: true, action: "click->reaction-form#stop" } do %>
+          <%= icon_tag "close" %><span class="for-screen-reader">Remove your reaction</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+  <button type="button" class="reactions__trigger btn btn--circle" data-action="reaction-form#open" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+  <form class="reaction__form" data-reaction-form-target="form" action="<%= card_comment_reaction_path(comment.card, comment) %>" method="post" data-turbo="true" hidden>
+    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
+    <label class="reaction__form-label flex align-center" for="reaction-body-<%= comment.id %>">
+      <%= text_field_tag "reaction[body]", nil, id: "reaction-body-#{comment.id}", maxlength: 16, class: "reaction__input input", autocomplete: "off", placeholder: "React…", data: { reaction_form_target: "input" } %>
+    </label>
+    <button type="submit" class="reaction__submit-btn btn btn--circle" aria-label="Confirm reaction"><%= icon_tag "check" %></button>
+    <button type="button" class="reaction__cancel-btn btn btn--circle" aria-label="Cancel" data-action="reaction-form#close"><%= icon_tag "close" %></button>
+  </form>
+</div>
