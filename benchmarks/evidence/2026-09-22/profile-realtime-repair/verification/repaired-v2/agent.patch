@@ -0,0 +1,59 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params.merge(creator: Current.user))
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.append(helpers.dom_id(@comment, :reaction_list),
+            partial: "cards/comments/reaction", locals: { reaction: @reaction })
+        end
+        format.json { render json: @comment.reactions, status: :ok }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.update(helpers.dom_id(@comment, :reaction_errors),
+            @reaction.errors.full_messages.to_sentence), status: :unprocessable_entity
+        end
+        format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    respond_to do |format|
+      format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+      format.json { render json: @comment.reactions, status: :ok }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
