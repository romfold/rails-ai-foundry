--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,27 @@
+class Reaction < ApplicationRecord
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :creator, class_name: "User", inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :comment_is_commentable
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_deletion
+
+  private
+    def comment_is_commentable
+      errors.add(:comment, "does not allow reactions") unless comment&.card&.commentable?
+    end
+
+    def broadcast_creation
+      Current.with(account: comment.account, user: nil) do
+        broadcast_append_to comment.card,
+          target: ActionView::RecordIdentifier.dom_id(comment, :reaction_list),
+          partial: "cards/comments/reaction", locals: { reaction: self }
+      end
+    end
+
+    def broadcast_deletion
+      broadcast_remove_to comment.card
+    end
+end
