diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..1e6a32c
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,21 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <% comment.reactions.order(:created_at, :id).each do |reaction| %>
+      <details class="reaction reaction--deleteable" data-creator-id="<%= reaction.creator_id %>">
+        <summary class="reaction__avatar btn btn--plain" title="<%= reaction.creator.name %>">
+          <%= avatar_tag reaction.creator, hidden_for_screen_reader: true, class: "reaction__avatar" %>
+          <span class="txt-small txt-medium" aria-label="<%= reaction.content %>"><%= reaction.content %></span>
+        </summary>
+        <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete, class: "reaction__delete btn btn--plain", title: "Remove reaction", data: { only_visible_to_you: true } do %>
+          <%= icon_tag "close" %><span class="for-screen-reader">Remove your reaction</span>
+        <% end %>
+      </details>
+    <% end %>
+  </div>
+  <button type="button" class="reactions__trigger btn btn--circle" data-action="reaction#showForm" title="Add a reaction"><%= image_tag "boost-color.svg", alt: "Add a reaction" %></button>
+  <%= form_with model: [comment.card, comment, Reaction.new], class: "reaction reaction__form", data: { reaction_target: "form", action: "turbo:submit-end->reaction#submitted" } do |form| %>
+    <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off", aria: { label: "Your reaction" }, data: { reaction_target: "input" } %>
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--plain", title: "Confirm" do %><%= icon_tag "check" %><% end %>
+    <button type="button" class="reaction__cancel-btn btn btn--plain" title="Cancel" data-action="reaction#cancel"><%= icon_tag "close" %></button>
+  <% end %>
+</div>
