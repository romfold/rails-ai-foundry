+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params.merge(creator_id: Current.user.id))
+    render_reactions
+  end
+
+  def destroy
+    @reaction.destroy!
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      respond_to do |format|
+        format.turbo_stream { render turbo_stream: turbo_stream.replace([ @comment, :reactions ], partial: "cards/comments/reactions", locals: { comment: @comment }) }
+        format.json { render json: @comment.reactions, status: :ok }
+      end
+    end
+end
