@@ -0,0 +1,39 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  def test_catalog_returns_only_published_documents_in_id_order
+    later = document(body: 'later')
+    document(body: 'draft', published: false)
+    earlier = document(body: 'earlier', tenant: 'b')
+
+    assert_equal [later.id], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], Knowledge::Catalog.list(tenant_id: 'a').first.keys
+    assert_equal [earlier.id], Knowledge::Catalog.list(tenant_id: 'b').map { |row| row.fetch('id') }
+  end
+
+  def test_publish_delivery_uses_catalog_without_changing_event_payload
+    delivery = Knowledge::Delivery.create!(event_id: 'event-1',
+                                            payload: JSON.generate(tenant_id: 'a', body: 'policy'))
+    calls = []
+    Knowledge::Catalog.stub(:list, ->(tenant_id:) { calls << tenant_id; [] }) do
+      store = Class.new do
+        attr_reader :published
+
+        def duplicate_error
+          Class.new(StandardError)
+        end
+
+        def publish(**event)
+          @published = event
+        end
+      end.new
+
+      assert_equal :delivered, Knowledge::PublishDelivery.new.call(delivery_id: delivery.id, store: store)
+      assert_equal ['a'], calls
+      assert_equal({ id: 'event-1', type: 'DocumentPublished', data: { 'tenant_id' => 'a', 'body' => 'policy' } },
+                   store.published)
+    end
+  end
+end
