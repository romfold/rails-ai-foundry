+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_tenant_documents_in_id_order
+    first = document(body: 'first')
+    document(body: 'draft', published: false)
+    other = document(tenant: 'b', body: 'other')
+    last = document(body: 'last', revision: 3)
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+    assert_equal [first.id, last.id], rows.map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], rows.first.keys
+    assert_equal({ 'id' => last.id, 'tenant_id' => 'a', 'body' => 'last', 'revision' => 3 }, rows.last)
+    refute_includes rows.map { |row| row.fetch('id') }, other.id
+  end
+
+  def test_delivery_reads_through_catalog_boundary
+    catalog = Knowledge::Catalog
+    original = catalog.method(:list)
+    calls = []
+    catalog.define_singleton_method(:list) do |tenant_id:|
+      calls << tenant_id
+      [{ 'id' => 1, 'tenant_id' => tenant_id, 'body' => 'body', 'revision' => 1 }]
+    end
+
+    get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-b-token' }
+    assert_equal 200, last_response.status
+    assert_equal ['b'], calls
+    assert_equal 'b', JSON.parse(last_response.body).first.fetch('tenant_id')
+  ensure
+    catalog.define_singleton_method(:list, &original.to_proc) if catalog && original
+  end
+end
