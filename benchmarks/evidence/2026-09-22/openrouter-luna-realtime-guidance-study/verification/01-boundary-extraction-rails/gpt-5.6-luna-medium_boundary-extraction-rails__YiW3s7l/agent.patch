@@ -0,0 +1,35 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_lists_only_published_documents_in_id_order
+    later = document(body: 'later')
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    assert_equal [later.id, earlier.id].sort,
+                 Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal %w[a a], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('tenant_id') }
+    assert_equal %w[later earlier], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('body') }
+  end
+
+  def test_documents_delivery_delegates_catalog_to_keep_persistence_internal
+    expected = [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'from catalog', 'revision' => 3 }]
+    Knowledge::Catalog.stub(:list, expected) do
+      Knowledge::Document.stub(:where, ->(*) { raise 'delivery accessed persistence' }) do
+        get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+      end
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal expected, JSON.parse(last_response.body)
+  end
+end
