@@ -0,0 +1,26 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class DeliveryBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    calls = []
+    Knowledge::Catalog.stub(:list, lambda { |tenant_id:|
+      calls << tenant_id
+      [{ 'id' => 7, 'tenant_id' => tenant_id, 'body' => 'from catalog', 'revision' => 2 }]
+    }) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-b-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal ['b'], calls
+    assert_equal [{ 'id' => 7, 'tenant_id' => 'b', 'body' => 'from catalog', 'revision' => 2 }],
+                 JSON.parse(last_response.body)
+  end
+end
