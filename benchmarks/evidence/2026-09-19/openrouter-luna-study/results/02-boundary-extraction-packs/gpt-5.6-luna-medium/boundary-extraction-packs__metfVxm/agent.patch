@@ -0,0 +1,39 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_rows_in_id_order_and_selected_shape
+    later = document(body: 'later', revision: 3)
+    earlier = Knowledge::Document.create!(tenant_id: 'a', body: 'earlier', revision: 2, published: true)
+    document(body: 'private', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    assert_equal [
+      { 'id' => later.id, 'tenant_id' => 'a', 'body' => 'later', 'revision' => 3 },
+      { 'id' => earlier.id, 'tenant_id' => 'a', 'body' => 'earlier', 'revision' => 2 }
+    ], Knowledge::Catalog.list(tenant_id: 'a')
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    rows = [{ 'id' => 7, 'tenant_id' => 'a', 'body' => 'published', 'revision' => 1 }]
+    Knowledge::Catalog.stub(:list, rows) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal rows, JSON.parse(last_response.body)
+  end
+
+  def test_documents_delivery_keeps_tenant_authentication
+    get '/documents'
+
+    assert_equal 401, last_response.status
+  end
+end
