diff --git a/test/embedding_job_test.rb b/test/embedding_job_test.rb
new file mode 100644
index 0000000..577d673
--- /dev/null
+++ b/test/embedding_job_test.rb
@@ -0,0 +1,62 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class EmbeddingJobTest < BenchmarkTest
+  def job(document, version: 'v1', provider: ->(_body) { [1.0] })
+    Knowledge::EmbeddingJob.new.call(document_id: document.id, tenant_id: document.tenant_id,
+                                      version: version, provider: provider)
+  end
+
+  def test_revision_change_while_provider_runs_discards_result
+    document = self.document
+    provider = lambda do |_body|
+      document.update!(revision: 2, body: 'new body')
+      [1.0]
+    end
+
+    assert_equal :discarded, job(document, provider: provider)
+    assert_empty Knowledge::Embedding.all
+  end
+
+  def test_withdrawal_deletion_and_tenant_change_while_provider_runs_discard
+    [
+      ->(record) { record.update!(published: false) },
+      ->(record) { record.destroy! },
+      ->(record) { record.update!(tenant_id: 'b') }
+    ].each do |change|
+      record = document
+      provider = lambda do |_body|
+        change.call(record)
+        [1.0]
+      end
+
+      assert_equal :discarded, job(record, provider: provider)
+      assert_empty Knowledge::Embedding.all
+    end
+  end
+
+  def test_older_result_does_not_overwrite_newer_embedding
+    record = document
+    Knowledge::Embedding.create!(document_id: record.id, tenant_id: 'a', revision: 2,
+                                 version: 'v1', vector: JSON.generate([2.0]))
+
+    assert_equal :stored, job(record, provider: ->(_body) { [1.0] })
+    embedding = Knowledge::Embedding.find_by!(document_id: record.id, version: 'v1')
+    assert_equal 2, embedding.revision
+    assert_equal [2.0], JSON.parse(embedding.vector)
+  end
+
+  def test_versions_coexist_and_provider_errors_do_not_write
+    record = document
+    assert_equal :stored, job(record, version: 'v1')
+    assert_equal :stored, job(record, version: 'v2', provider: ->(_body) { [2.0] })
+    assert_equal %w[v1 v2], Knowledge::Embedding.order(:version).pluck(:version)
+
+    error = assert_raises(RuntimeError) do
+      job(record, version: 'v3', provider: ->(_body) { raise 'provider failed' })
+    end
+    assert_equal 'provider failed', error.message
+    refute Knowledge::Embedding.exists?(version: 'v3')
+  end
+end
