diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..159dc55
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,28 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" aria-label="Reactions">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).order(:created_at).each do |reaction| %>
+      <div class="reaction <%= "reaction--deleteable" if reaction.creator == Current.user %>" title="<%= reaction.creator.name %>" data-controller="toggle-class" data-toggle-class-toggle-class="expanded" data-action="click->toggle-class#toggle">
+        <span class="txt-small txt-medium"><%= reaction.content %></span>
+        <% if reaction.creator == Current.user %>
+          <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+                class: "reaction__delete btn btn--circle borderless", title: "Remove your reaction" do %>
+            <%= icon_tag "close" %><span class="for-screen-reader">Remove reaction</span>
+          <% end %>
+        <% else %>
+          <%= avatar_tag reaction.creator, hidden_for_screen_reader: true, class: "reaction__avatar" %>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <details class="reaction__menu">
+    <summary class="reactions__trigger btn btn--circle" title="Add a reaction"><%= image_tag "boost-color.svg", alt: "Add a reaction" %></summary>
+    <div class="reaction__popup panel">
+      <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "reaction__form expanded flex-inline align-center", data: { controller: "reaction-form" } do |form| %>
+        <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true, autofocus: true, placeholder: "React…", aria: { label: "Your reaction" } %>
+        <%= form.button "✓", class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction" %>
+        <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" data-action="reaction-form#cancel">×</button>
+      <% end %>
+    </div>
+  </details>
+</div>
