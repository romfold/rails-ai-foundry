new file mode 100644
index 0000000..bb00cc1
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,17 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :creator_id, uniqueness: { scope: :comment_id }
+
+  after_create_commit :broadcast_strip
+  after_destroy_commit :broadcast_strip
+
+  private
+    def broadcast_strip
+      broadcast_replace_to comment.card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions", locals: { comment: comment.reload }
+    end
+end
