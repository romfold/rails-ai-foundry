diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..f09f672
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,29 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params)
+    redirect_to card_path(@card), status: :see_other unless request.format.turbo_stream?
+  end
+
+  def destroy
+    return head :forbidden unless @reaction.creator == Current.user
+    @reaction.destroy!
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
