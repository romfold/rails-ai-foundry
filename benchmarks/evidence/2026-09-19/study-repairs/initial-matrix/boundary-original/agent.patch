diff --git a/test/knowledge_boundary_test.rb b/test/knowledge_boundary_test.rb
new file mode 100644
index 0000000..5995282
--- /dev/null
+++ b/test/knowledge_boundary_test.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+  def test_catalog_returns_only_published_rows_in_id_order
+    later = document(body: 'later', revision: 3)
+    document(body: 'draft', published: false)
+    earlier = document(body: 'earlier', revision: 2)
+
+    assert_equal [later.id, earlier.id], Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal({ 'id' => earlier.id, 'tenant_id' => 'a', 'body' => 'earlier', 'revision' => 2 },
+                 Knowledge::Catalog.list(tenant_id: 'a').last)
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    catalog = Minitest::Mock.new
+    catalog.expect(:list, [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'policy', 'revision' => 1 }], tenant_id: 'a')
+    Knowledge::Catalog.stub(:list, ->(**kwargs) { catalog.list(**kwargs) }) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'policy', 'revision' => 1 }], JSON.parse(last_response.body)
+    catalog.verify
+  end
+end
