diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..0a92cde
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,29 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+    redirect_to card_path(@card), status: :see_other unless request.format.turbo_stream?
+  end
+
+  def destroy
+    return head :forbidden unless @reaction.creator == Current.user
+    @reaction.destroy!
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_entry_controller.js b/app/javascript/controllers/reaction_entry_controller.js
new file mode 100644
index 0000000..bdc6bb2
--- /dev/null
+++ b/app/javascript/controllers/reaction_entry_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+  static targets = [ "controls" ]
+
+  connect() {
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.append(this.controlsTarget.content.cloneNode(true))
+    }
+    this.controlsTarget.remove()
+  }
+
+  toggle() {
+    if (this.owned) this.element.classList.toggle("expanded")
+  }
+
+  get owned() {
+    return Current.user?.id === this.creatorIdValue
+  }
+}
