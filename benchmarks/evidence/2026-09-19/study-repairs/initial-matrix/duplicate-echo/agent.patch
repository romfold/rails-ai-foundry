diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..7646325
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,23 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :creator_id, uniqueness: { scope: :comment_id }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_deletion
+
+  private
+    def broadcast_creation
+      Current.with_account(account) do
+        broadcast_append_to comment.card, target: ActionView::RecordIdentifier.dom_id(comment, :reaction_list),
+          partial: "cards/comments/reaction", locals: { reaction: self }
+      end
+    end
+
+    def broadcast_deletion
+      broadcast_remove_to comment.card
+    end
+end
