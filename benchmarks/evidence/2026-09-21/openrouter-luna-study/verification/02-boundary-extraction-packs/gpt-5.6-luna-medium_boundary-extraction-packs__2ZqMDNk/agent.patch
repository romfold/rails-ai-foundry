new file mode 100644
index 0000000..60fad32
--- /dev/null
+++ b/packs/knowledge/test/catalog_test.rb
@@ -0,0 +1,34 @@
+# frozen_string_literal: true
+
+require_relative '../../../test/test_helper'
+
+class KnowledgeCatalogTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_lists_only_published_documents_for_tenant_in_id_order_with_public_fields
+    first = document(body: 'first')
+    document(body: 'hidden', published: false)
+    last = document(body: 'last', revision: 3)
+    document(tenant: 'b', body: 'other tenant')
+
+    assert_equal [
+      { 'id' => first.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+      { 'id' => last.id, 'tenant_id' => 'a', 'body' => 'last', 'revision' => 3 }
+    ], Knowledge::Catalog.list(tenant_id: 'a')
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    called_with = nil
+    result = [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'body', 'revision' => 1 }]
+    Knowledge::Catalog.stub :list, lambda { |tenant_id:| called_with = tenant_id; result } do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+      assert_equal 200, last_response.status
+      assert_equal 42, JSON.parse(last_response.body).first.fetch('id')
+    end
+    assert_equal 'a', called_with
+  end
+end
