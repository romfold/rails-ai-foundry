diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..32a361e
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,36 @@
+<div class="reactions" data-controller="reaction" data-reaction-expanded-class="expanded">
+  <div class="reactions__list" aria-label="Reactions">
+    <% comment.reactions.includes(:user).each do |reaction| %>
+      <div class="reaction <%= "reaction--deleteable" if reaction.user == Current.user %>" title="<%= reaction.user.name %>"<%= " data-controller=\"toggle-class\" data-toggle-class-toggle-class-value=\"expanded\" data-action=\"click->toggle-class#toggle\"" if reaction.user == Current.user %>>
+        <%= avatar_tag reaction.user, class: "reaction__avatar", hidden_for_screen_reader: true %>
+        <span class="txt-small <%= "txt-medium" if reaction.body.length <= 2 %>"><%= reaction.body %></span>
+        <% if reaction.user == Current.user %>
+          <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+                class: "reaction__delete btn btn--circle borderless", title: "Remove reaction",
+                data: { turbo_confirm: "Remove this reaction?" } do %>
+            <%= icon_tag "close" %><span class="for-screen-reader">Remove reaction</span>
+          <% end %>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="reaction reaction__form" data-reaction-target="form" hidden>
+    <%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction,
+          data: { action: "turbo:submit-start->reaction#submit" } do |form| %>
+      <%= form.text_field :body, class: "reaction__input input", maxlength: 16, autocomplete: "off",
+            required: true, aria: { label: "Reaction (16 characters maximum)" }, data: { reaction_target: "input" } %>
+      <%= button_tag type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+        <%= icon_tag "check" %><span class="for-screen-reader">Confirm reaction</span>
+      <% end %>
+      <%= button_tag type: :button, class: "reaction__cancel-btn btn btn--circle borderless", title: "Cancel", data: { action: "reaction#cancel" } do %>
+        <%= icon_tag "close" %><span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle borderless" title="Add reaction" data-action="reaction#open">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add reaction</span>
+  </button>
+</div>
