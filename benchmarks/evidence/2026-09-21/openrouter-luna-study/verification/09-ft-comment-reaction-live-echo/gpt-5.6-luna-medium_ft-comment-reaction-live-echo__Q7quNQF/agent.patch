+++ b/app/models/reaction.rb
@@ -0,0 +1,18 @@
+class Reaction < ApplicationRecord
+  belongs_to :comment
+  belongs_to :user
+
+  validates :body, presence: true, length: { maximum: 16 }
+  validates :user_id, uniqueness: { scope: :comment_id }
+
+  after_create_commit :broadcast_comment
+  after_destroy_commit :broadcast_comment
+
+  private
+    def broadcast_comment
+      broadcast_replace_later_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :container),
+        partial: "cards/comments/comment",
+        locals: { comment: comment }
+    end
+end
