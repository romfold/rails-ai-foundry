+++ b/db/migrate/20250918000000_add_tenants.rb
@@ -0,0 +1,22 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |direction|
+      direction.up do
+        tenant_id = execute("INSERT INTO tenants (name, created_at, updated_at) VALUES ('Default', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)").last&.first
+        # SQLite returns the inserted id through last_insert_rowid; the fallback is
+        # useful for adapters which do not return rows from INSERT.
+        tenant_id ||= select_value("SELECT id FROM tenants ORDER BY id LIMIT 1")
+        execute("UPDATE users SET tenant_id = #{connection.quote(tenant_id)}")
+        execute("UPDATE books SET tenant_id = #{connection.quote(tenant_id)}")
+      end
+    end
+  end
+end
