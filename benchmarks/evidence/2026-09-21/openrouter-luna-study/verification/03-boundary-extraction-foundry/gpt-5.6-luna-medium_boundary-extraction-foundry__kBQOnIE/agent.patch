@@ -0,0 +1,41 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeCatalogTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_lists_only_published_documents_for_tenant_in_id_order
+    first = document(body: 'first')
+    second = document(body: 'second')
+    document(body: 'draft', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+    assert_equal [first.id, second.id], rows.map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], rows.first.keys
+  end
+
+  def test_documents_delivery_uses_catalog_boundary
+    document
+    catalog = Knowledge::Catalog
+    original = catalog.method(:list)
+    calls = []
+    catalog.define_singleton_method(:list) do |tenant_id:|
+      calls << tenant_id
+      [{ 'id' => 99, 'tenant_id' => tenant_id, 'body' => 'from catalog', 'revision' => 1 }]
+    end
+
+    get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+
+    assert_equal 200, last_response.status
+    assert_equal 'from catalog', JSON.parse(last_response.body).first.fetch('body')
+    assert_equal ['a'], calls
+  ensure
+    catalog.define_singleton_method(:list, original) if catalog
+  end
+end
