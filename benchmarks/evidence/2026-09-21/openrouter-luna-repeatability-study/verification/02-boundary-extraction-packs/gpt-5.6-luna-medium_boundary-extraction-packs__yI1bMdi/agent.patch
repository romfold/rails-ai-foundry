new file mode 100644
index 0000000..bdf029a
--- /dev/null
+++ b/test/knowledge_boundary_test.rb
@@ -0,0 +1,41 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_documents_in_id_order
+    first = document(body: 'first')
+    document(body: 'not published', published: false)
+    last = document(body: 'last', revision: 2)
+
+    assert_equal(
+      [
+        { 'id' => first.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+        { 'id' => last.id, 'tenant_id' => 'a', 'body' => 'last', 'revision' => 2 }
+      ],
+      Knowledge::Catalog.list(tenant_id: 'a')
+    )
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    Knowledge::Catalog.stub(:list, [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'from catalog', 'revision' => 3 }]) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'from catalog', 'revision' => 3 }],
+                 JSON.parse(last_response.body)
+  end
+
+  def test_documents_delivery_keeps_tenant_authentication
+    get '/documents'
+
+    assert_equal 401, last_response.status
+  end
+end
