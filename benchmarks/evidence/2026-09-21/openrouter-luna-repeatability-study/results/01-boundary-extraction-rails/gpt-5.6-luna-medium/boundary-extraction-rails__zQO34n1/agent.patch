@@ -0,0 +1,46 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_documents_for_tenant_in_id_order
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+    document(tenant: 'b', body: 'other tenant')
+    later = document(body: 'later')
+
+    assert_equal [
+      { 'id' => earlier.id, 'tenant_id' => 'a', 'body' => 'earlier', 'revision' => 1 },
+      { 'id' => later.id, 'tenant_id' => 'a', 'body' => 'later', 'revision' => 1 }
+    ], Knowledge::Catalog.list(tenant_id: 'a')
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    calls = []
+    result = [{ 'id' => 42, 'tenant_id' => 'a', 'body' => 'from catalog', 'revision' => 3 }]
+
+    Knowledge::Catalog.stub(:list, ->(tenant_id:) { calls << tenant_id; result }) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal ['a'], calls
+    assert_equal result, JSON.parse(last_response.body)
+  end
+
+  def test_unauthorized_documents_delivery_does_not_call_catalog
+    called = false
+    Knowledge::Catalog.stub(:list, ->(**) { called = true }) do
+      get '/documents'
+    end
+
+    assert_equal 401, last_response.status
+    refute called
+  end
+end
