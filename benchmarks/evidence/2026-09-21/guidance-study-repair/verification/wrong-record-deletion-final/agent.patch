diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..dfb6d73
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,24 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" aria-label="Reactions">
+  <div id="<%= dom_id(comment, :reaction_list) %>" class="reactions__list">
+    <%= render partial: "cards/comments/reaction", collection: comment.reactions.includes(:creator).order(:created_at, :id) %>
+  </div>
+
+  <details id="<%= dom_id(comment, :reaction_composer) %>" class="reaction__menu" data-turbo-permanent data-controller="reactions">
+    <summary class="reactions__trigger btn btn--circle" title="Add reaction"><%= image_tag "boost-color.svg", alt: "Add reaction" %></summary>
+    <div class="reaction__popup panel">
+      <%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction,
+            class: "reaction__form expanded flex-inline align-center",
+            data: { reactions_target: "form", action: "turbo:submit-start->reactions#submitting turbo:submit-end->reactions#submitted" } do |form| %>
+        <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off",
+              required: true, autofocus: true, aria: { label: "Your reaction" } %>
+        <%= button_tag type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction" do %>
+          <%= icon_tag "check" %><span class="for-screen-reader">Confirm reaction</span>
+        <% end %>
+        <%= button_tag type: :button, class: "reaction__cancel-btn btn btn--circle borderless", title: "Cancel", data: { action: "reactions#cancel" } do %>
+          <%= icon_tag "close" %><span class="for-screen-reader">Cancel</span>
+        <% end %>
+      <% end %>
+      <div id="<%= dom_id(comment, :reaction_errors) %>" role="alert" data-reactions-target="errors"></div>
+    </div>
+  </details>
+</div>
