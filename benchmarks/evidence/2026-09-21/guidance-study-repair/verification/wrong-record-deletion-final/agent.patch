diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..1940056
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,36 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.new(content: reaction_params[:content].to_s.strip, creator: Current.user)
+    if @reaction.save
+      redirect_to card_path(@card), status: :see_other unless request.format.turbo_stream?
+    else
+      render turbo_stream: turbo_stream.update(helpers.dom_id(@comment, :reaction_errors),
+        @reaction.errors.full_messages.to_sentence), status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    return head(:forbidden) unless @reaction.creator == Current.user
+
+    @reaction.destroy!
+    redirect_to card_path(@card), status: :see_other unless request.format.turbo_stream?
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_entry_controller.js b/app/javascript/controllers/reaction_entry_controller.js
new file mode 100644
index 0000000..bdc6bb2
--- /dev/null
+++ b/app/javascript/controllers/reaction_entry_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+  static targets = [ "controls" ]
+
+  connect() {
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.append(this.controlsTarget.content.cloneNode(true))
+    }
+    this.controlsTarget.remove()
+  }
+
+  toggle() {
+    if (this.owned) this.element.classList.toggle("expanded")
+  }
+
+  get owned() {
+    return Current.user?.id === this.creatorIdValue
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..6e429bc
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "errors" ]
+
+  submitting() {
+    this.errorsTarget.textContent = ""
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.errorsTarget.textContent = ""
+    this.element.removeAttribute("open")
+  }
+}
