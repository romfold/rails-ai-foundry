new file mode 100644
index 0000000..c0f10b5
--- /dev/null
+++ b/test/regression_test.rb
@@ -0,0 +1,36 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_returns_only_published_documents_in_id_order
+    later = document(body: 'later')
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    assert_equal(
+      [
+        { 'id' => later.id, 'tenant_id' => 'a', 'body' => 'later', 'revision' => 1 },
+        { 'id' => earlier.id, 'tenant_id' => 'a', 'body' => 'earlier', 'revision' => 1 }
+      ],
+      Knowledge::Catalog.list(tenant_id: 'a')
+    )
+  end
+
+  def test_documents_delivery_calls_catalog_api
+    response = [{ 'id' => 7, 'tenant_id' => 'a', 'body' => 'policy', 'revision' => 2 }]
+    Knowledge::Catalog.stub(:list, response) do
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal response, JSON.parse(last_response.body)
+  end
+end
