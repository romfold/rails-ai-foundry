diff --git a/test/embedding_job_test.rb b/test/embedding_job_test.rb
new file mode 100644
index 0000000..08c6b9a
--- /dev/null
+++ b/test/embedding_job_test.rb
@@ -0,0 +1,68 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class EmbeddingJobTest < BenchmarkTest
+  def job(document, version: 'v1', provider: ->(_body) { [1.0, 2.0] })
+    Knowledge::EmbeddingJob.new.call(document_id: document.id, tenant_id: document.tenant_id,
+                                      version: version, provider: provider)
+  end
+
+  def test_provider_is_outside_transaction_and_versions_coexist
+    doc = document
+    saw_transaction = nil
+    provider = lambda do |_body|
+      saw_transaction = ActiveRecord::Base.connection.open_transactions
+      [1.0, 2.0]
+    end
+
+    assert_equal :stored, job(doc, provider: provider)
+    assert_equal :stored, job(doc, version: 'v2')
+    assert_equal 0, saw_transaction
+    assert_equal %w[v1 v2], Knowledge::Embedding.order(:version).pluck(:version)
+  end
+
+  [:withdraw, :revise, :reassign, :delete].each do |mutation|
+    define_method("test_discards_when_document_#{mutation}_during_provider") do
+      doc = document
+      provider = lambda do |_body|
+        case mutation
+        when :withdraw then doc.update!(published: false)
+        when :revise then doc.update!(revision: 2)
+        when :reassign then doc.update!(tenant_id: 'b')
+        when :delete then doc.destroy!
+        end
+        [1.0]
+      end
+
+      assert_equal :discarded, job(doc, provider: provider)
+      assert_empty Knowledge::Embedding.where(document_id: doc.id)
+    end
+  end
+
+  def test_discards_when_initial_snapshot_is_unavailable
+    doc = document(published: false)
+    provider_called = false
+    provider = ->(_body) { provider_called = true; [1.0] }
+
+    assert_equal :discarded, job(doc, provider: provider)
+    refute provider_called
+    assert_empty Knowledge::Embedding.all
+  end
+
+  def test_provider_error_propagates_without_writing
+    doc = document
+    error = assert_raises(RuntimeError) { job(doc, provider: ->(_body) { raise 'provider failed' }) }
+    assert_equal 'provider failed', error.message
+    assert_empty Knowledge::Embedding.all
+  end
+
+  def test_older_result_does_not_replace_newer_embedding
+    doc = document(revision: 1)
+    Knowledge::Embedding.create!(document_id: doc.id, tenant_id: 'a', revision: 2,
+                                 version: 'v1', vector: JSON.generate([9.0]))
+
+    assert_equal :stored, job(doc, provider: ->(_body) { [1.0] })
+    assert_equal [9.0], JSON.parse(Knowledge::Embedding.find_by!(document_id: doc.id, version: 'v1').vector)
+  end
+end
