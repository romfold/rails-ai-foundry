@@ -0,0 +1,40 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_catalog_lists_only_published_documents_in_id_order
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+    later = document(body: 'later')
+
+    assert_equal(
+      [
+        { 'id' => earlier.id, 'tenant_id' => 'a', 'body' => 'earlier', 'revision' => 1 },
+        { 'id' => later.id, 'tenant_id' => 'a', 'body' => 'later', 'revision' => 1 }
+      ],
+      Knowledge::Catalog.list(tenant_id: 'a')
+    )
+  end
+
+  def test_delivery_delegates_catalog_access
+    expected = [{ 'id' => 7, 'tenant_id' => 'a', 'body' => 'from catalog', 'revision' => 3 }]
+    catalog = Knowledge::Catalog
+    document = Knowledge::Document
+
+    catalog.stub(:list, expected) do
+      document.stub(:where, ->(*) { raise 'delivery accessed persistence' }) do
+        get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+      end
+    end
+
+    assert_equal 200, last_response.status
+    assert_equal expected, JSON.parse(last_response.body)
+  end
+end
