diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..d536b16
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,22 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions" data-reactions-current-user-id-value="<%= Current.user&.id %>">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).each do |reaction| %>
+      <div class="reaction <%= "reaction--deleteable" if reaction.creator == Current.user %>" data-reactions-target="reaction" data-action="click->reactions#toggle" data-creator-id="<%= reaction.creator_id %>">
+        <span class="reaction__avatar" title="<%= reaction.creator.name %>"><%= avatar_tag reaction.creator, hidden_for_screen_reader: true %></span>\n        <span class="txt-small txt-medium" title="<%= reaction.creator.name %>"><%= reaction.content %></span>
+        <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+              class: "reaction__delete btn btn--plain", title: "Remove reaction", aria: { label: "Remove reaction" },
+              data: { turbo: true, action: "click->reactions#stop" } %>
+      </div>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-action="reactions#open" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "reaction__form", data: { reactions_target: "form", action: "submit->reactions#submit turbo:submit-end->reactions#submitted" } do |form| %>
+    <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off", aria: { label: "Reaction" }, data: { reactions_target: "input" } %>
+    <button type="submit" class="reaction__submit-btn btn btn--plain" aria-label="Confirm reaction"><%= icon_tag "check" %></button>
+    <button type="button" class="reaction__cancel-btn btn btn--plain" aria-label="Cancel" data-action="reactions#cancel"><%= icon_tag "close" %></button>
+  <% end %>
+</div>
