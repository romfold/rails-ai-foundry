diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..8009c80
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,34 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @comment.reactions.create!(content: reaction_params[:content].strip, creator: Current.user)
+    respond_to { |format| format.turbo_stream; format.html { render_reactions } }
+  end
+
+  def destroy
+    return head(:forbidden) unless @reaction.creator == Current.user
+    @reaction.destroy!
+    respond_to { |format| format.turbo_stream; format.html { render_reactions } }
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      render partial: "cards/comments/reactions", locals: { comment: @comment.reload }
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..138976f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["form", "input", "reaction"]
+  static values = { currentUserId: String }
+
+  connect() {
+    this.formTarget.hidden = true
+  }
+
+  open() {
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+  }
+
+  toggle(event) {
+    if (event.currentTarget.dataset.creatorId !== this.currentUserIdValue) return
+    event.currentTarget.classList.toggle("expanded")
+  }
+
+  submit(event) {
+    if (!this.inputTarget.value.trim()) event.preventDefault()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+}
