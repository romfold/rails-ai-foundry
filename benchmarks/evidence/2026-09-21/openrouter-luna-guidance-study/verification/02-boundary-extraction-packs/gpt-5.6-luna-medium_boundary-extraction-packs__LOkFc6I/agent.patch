@@ -0,0 +1,45 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryRegressionTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+  def test_catalog_returns_only_published_documents_in_id_order
+    later = document(body: 'later')
+    earlier = document(body: 'earlier')
+    document(body: 'draft', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    assert_equal [later.id, earlier.id].sort, Knowledge::Catalog.list(tenant_id: 'a').map { |row| row.fetch('id') }
+    assert_equal %w[id tenant_id body revision], Knowledge::Catalog.list(tenant_id: 'a').first.keys
+  end
+
+  def test_delivery_delegates_to_catalog
+    document(body: 'through boundary')
+    catalog = Knowledge::Catalog
+    calls = []
+    catalog.define_singleton_method(:list) do |tenant_id:|
+      calls << tenant_id
+      [{ 'id' => 1, 'tenant_id' => tenant_id, 'body' => 'stub', 'revision' => 1 }]
+    end
+
+    begin
+      app = Rails.application
+      get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+      request = last_response
+      assert_equal 200, request.status
+      assert_equal 'a', calls.first
+      assert_equal 'stub', JSON.parse(request.body).first.fetch('body')
+    ensure
+      catalog.define_singleton_method(:list) do |tenant_id:|
+        Document.where(tenant_id: tenant_id, published: true).order(:id).map do |document|
+          document.attributes.slice('id', 'tenant_id', 'body', 'revision')
+        end
+      end
+    end
+  end
+end
