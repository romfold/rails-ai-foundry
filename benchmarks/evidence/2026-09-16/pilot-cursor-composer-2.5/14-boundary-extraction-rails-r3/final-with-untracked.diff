--- /dev/null
+++ b/app/services/knowledge/internal/published_documents.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+module Knowledge
+  module Internal
+    module PublishedDocuments
+      module_function
+
+      def for_tenant(tenant_id)
+        slice_rows(Document.where(tenant_id: tenant_id, published: true).order(:id))
+      end
+
+      def all
+        slice_rows(Document.where(published: true).order(:id))
+      end
+
+      def slice_rows(scope)
+        scope.map do |document|
+          document.attributes.slice('id', 'tenant_id', 'body', 'revision')
+        end
+      end
+      private_class_method :slice_rows
+    end
+  end
+end
