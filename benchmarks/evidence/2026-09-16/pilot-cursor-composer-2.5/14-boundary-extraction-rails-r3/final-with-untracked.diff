diff --git a/test/knowledge_boundary_test.rb b/test/knowledge_boundary_test.rb
new file mode 100644
index 0000000..6384ee8
--- /dev/null
+++ b/test/knowledge_boundary_test.rb
@@ -0,0 +1,35 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  def test_catalog_lists_published_documents_for_tenant_ordered_by_id
+    first = document(tenant: 'a', body: 'first', revision: 1)
+    second = document(tenant: 'a', body: 'second', revision: 2)
+    document(tenant: 'b', body: 'other tenant')
+    document(tenant: 'a', body: 'draft', published: false)
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+
+    assert_equal [first.id, second.id], rows.map { |row| row.fetch('id') }
+    assert_equal(
+      [
+        { 'id' => first.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+        { 'id' => second.id, 'tenant_id' => 'a', 'body' => 'second', 'revision' => 2 }
+      ],
+      rows
+    )
+  end
+
+  def test_documents_delivery_delegates_to_catalog
+    document(tenant: 'a', body: 'policy')
+
+    assert_equal Knowledge::Catalog.list(tenant_id: 'a'), Documents::Delivery.list(tenant_id: 'a')
+  end
+
+  def test_documents_delivery_source_uses_catalog_only
+    delivery_source = File.read(File.expand_path('../app/services/documents/delivery.rb', __dir__))
+    refute_match(/Knowledge::Document/, delivery_source)
+    assert_match(/Knowledge::Catalog\.list/, delivery_source)
+  end
+end
