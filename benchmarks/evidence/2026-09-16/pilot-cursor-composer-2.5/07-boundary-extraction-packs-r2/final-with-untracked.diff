+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class DeliveryPublishedDocumentsTest < BenchmarkTest
+  def test_list_delegates_to_knowledge_catalog
+    expected = document(body: 'shipping policy')
+
+    rows = Delivery::PublishedDocuments.list(tenant_id: 'a')
+
+    assert_equal 1, rows.size
+    assert_equal expected.id, rows.first.fetch('id')
+    assert_equal 'shipping policy', rows.first.fetch('body')
+  end
+end
