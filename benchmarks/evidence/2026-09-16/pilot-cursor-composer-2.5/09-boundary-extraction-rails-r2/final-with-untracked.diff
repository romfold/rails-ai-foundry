diff --git a/test/knowledge_boundary_test.rb b/test/knowledge_boundary_test.rb
new file mode 100644
index 0000000..3c6a78e
--- /dev/null
+++ b/test/knowledge_boundary_test.rb
@@ -0,0 +1,47 @@
+# frozen_string_literal: true
+
+# Rollback: remove DocumentStore, restore Catalog.list and RebuildSearch#documents to query
+# Knowledge::Document directly, and revert PublishDelivery to publish the raw JSON payload.
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  def test_catalog_lists_published_documents_for_tenant_ordered_by_id
+    older = document(tenant: 'a', body: 'first', revision: 1)
+    newer = document(tenant: 'a', body: 'second', revision: 2)
+    document(tenant: 'b', body: 'other tenant')
+    document(tenant: 'a', body: 'draft', published: false)
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+
+    assert_equal [older.id, newer.id], rows.map { |row| row.fetch('id') }
+    assert_equal(
+      [{ 'id' => older.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+       { 'id' => newer.id, 'tenant_id' => 'a', 'body' => 'second', 'revision' => 2 }],
+      rows
+    )
+  end
+
+  def test_publish_delivery_uses_catalog_snapshot
+    doc = document(tenant: 'a', body: 'canonical body', revision: 3)
+    delivery = Knowledge::Delivery.create!(
+      event_id: 'evt-1',
+      payload: JSON.generate('id' => doc.id, 'tenant_id' => 'a', 'body' => 'stale body', 'revision' => 99)
+    )
+    published = []
+    store = Class.new do
+      define_method(:duplicate_error) { StandardError }
+      define_method(:publish) { |id:, type:, data:| published << { id: id, type: type, data: data } }
+      define_method(:read) { |_id| nil }
+    end.new
+
+    result = Knowledge::PublishDelivery.new.call(delivery_id: delivery.id, store: store)
+
+    assert_equal :delivered, result
+    assert_equal(
+      [{ id: 'evt-1', type: 'DocumentPublished',
+         data: { 'id' => doc.id, 'tenant_id' => 'a', 'body' => 'canonical body', 'revision' => 3 } }],
+      published
+    )
+    assert delivery.reload.delivered
+  end
+end
