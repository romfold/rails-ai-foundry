@@ -0,0 +1,61 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeCatalogTest < BenchmarkTest
+  def test_list_returns_published_documents_for_tenant_ordered_by_id
+    older = document(tenant: 'a', body: 'first', revision: 1)
+    newer = document(tenant: 'a', body: 'second', revision: 2)
+    document(tenant: 'a', published: false)
+    document(tenant: 'b', body: 'other tenant')
+
+    listed = Knowledge::Catalog.list(tenant_id: 'a')
+
+    assert_equal [older.id, newer.id], listed.map { |row| row.fetch('id') }
+    assert_equal(
+      { 'id' => older.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+      listed.first
+    )
+  end
+
+  def test_publish_delivery_reads_snapshot_from_catalog
+    published = document(tenant: 'a', body: 'policy', revision: 3)
+    delivery = Knowledge::Delivery.create!(
+      event_id: 'evt-1',
+      payload: JSON.generate({ 'id' => published.id, 'tenant_id' => 'a', 'body' => 'stale', 'revision' => 0 })
+    )
+    store = FakeEventStore.new
+
+    result = Knowledge::PublishDelivery.new.call(delivery_id: delivery.id, store: store)
+
+    assert_equal :delivered, result
+    assert_equal(
+      { type: 'DocumentPublished', data: Knowledge::Catalog.list(tenant_id: 'a').first },
+      store.events['evt-1']
+    )
+  end
+end
+
+class FakeEventStore
+  class DuplicateError < StandardError; end
+
+  attr_reader :events
+
+  def initialize
+    @events = {}
+  end
+
+  def publish(id:, type:, data:)
+    raise duplicate_error if @events.key?(id)
+
+    @events[id] = { type: type, data: data }
+  end
+
+  def read(id)
+    @events[id]
+  end
+
+  def duplicate_error
+    DuplicateError
+  end
+end
