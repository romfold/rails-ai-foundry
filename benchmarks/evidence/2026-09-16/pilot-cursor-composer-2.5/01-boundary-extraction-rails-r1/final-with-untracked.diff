--- /dev/null
+++ b/app/services/knowledge/persistence/published_documents.rb
@@ -0,0 +1,23 @@
+# frozen_string_literal: true
+
+module Knowledge
+  module Persistence
+    module PublishedDocuments
+      CATALOG_KEYS = %w[id tenant_id body revision].freeze
+
+      module_function
+
+      def for_tenant(tenant_id)
+        Document.where(tenant_id: tenant_id, published: true).order(:id).map { |row| catalog_hash(row) }
+      end
+
+      def all
+        Document.where(published: true).order(:id).map { |row| catalog_hash(row) }
+      end
+
+      def catalog_hash(row)
+        row.attributes.slice(*CATALOG_KEYS)
+      end
+    end
+  end
+end
