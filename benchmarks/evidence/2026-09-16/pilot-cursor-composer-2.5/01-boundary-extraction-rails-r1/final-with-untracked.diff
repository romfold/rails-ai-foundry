+++ b/test/knowledge_boundary_test.rb
@@ -0,0 +1,40 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  def test_catalog_list_returns_published_documents_for_tenant_ordered_by_id
+    first = document(tenant: 'a', body: 'first', revision: 1)
+    second = document(tenant: 'a', body: 'second', revision: 2)
+    document(tenant: 'b', body: 'other tenant', revision: 1)
+    document(tenant: 'a', body: 'draft', published: false)
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+
+    assert_equal [first.id, second.id], rows.map { |row| row.fetch('id') }
+    assert_equal(
+      [
+        { 'id' => first.id, 'tenant_id' => 'a', 'body' => 'first', 'revision' => 1 },
+        { 'id' => second.id, 'tenant_id' => 'a', 'body' => 'second', 'revision' => 2 }
+      ],
+      rows
+    )
+  end
+
+  def test_delivery_published_documents_delegates_to_catalog
+    expected = document(tenant: 'a', body: 'policy')
+
+    catalog_rows = Knowledge::Catalog.list(tenant_id: 'a')
+    delivery_rows = Knowledge::Delivery::PublishedDocuments.list(tenant_id: 'a')
+
+    assert_equal catalog_rows, delivery_rows
+    assert_equal [expected.id], delivery_rows.map { |row| row.fetch('id') }
+  end
+
+  def test_delivery_published_documents_does_not_touch_persistence
+    source = File.read(File.expand_path('../app/services/knowledge/delivery/published_documents.rb', __dir__))
+    refute_match(/Knowledge::Document/, source)
+    refute_match(/Document\./, source)
+    refute_match(/Persistence::/, source)
+  end
+end
