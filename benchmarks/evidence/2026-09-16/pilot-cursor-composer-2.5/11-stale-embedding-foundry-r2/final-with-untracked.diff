diff --git a/test/embedding_job_test.rb b/test/embedding_job_test.rb
new file mode 100644
index 0000000..efe6dcf
--- /dev/null
+++ b/test/embedding_job_test.rb
@@ -0,0 +1,72 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class EmbeddingJobTest < BenchmarkTest
+  def job
+    Knowledge::EmbeddingJob.new
+  end
+
+  def test_discards_when_document_not_published
+    doc = document(published: false)
+    result = job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: ->(_b) { [1] })
+    assert_equal :discarded, result
+    assert_equal 0, Knowledge::Embedding.count
+  end
+
+  def test_discards_when_document_withdrawn_during_provider_call
+    doc = document
+    provider = lambda do |_body|
+      doc.update!(published: false)
+      [1]
+    end
+    result = job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: provider)
+    assert_equal :discarded, result
+    assert_equal 0, Knowledge::Embedding.count
+  end
+
+  def test_discards_when_revision_changes_during_provider_call
+    doc = document(revision: 1)
+    provider = lambda do |_body|
+      doc.update!(revision: 2)
+      [1]
+    end
+    result = job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: provider)
+    assert_equal :discarded, result
+    assert_equal 0, Knowledge::Embedding.count
+  end
+
+  def test_discards_when_tenant_reassigned_during_provider_call
+    doc = document(tenant: 'a')
+    provider = lambda do |_body|
+      doc.update!(tenant_id: 'b')
+      [1]
+    end
+    result = job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: provider)
+    assert_equal :discarded, result
+    assert_equal 0, Knowledge::Embedding.count
+  end
+
+  def test_does_not_overwrite_newer_embedding_with_older_result
+    doc = document(revision: 2)
+    Knowledge::Embedding.create!(document_id: doc.id, tenant_id: 'a', revision: 3, version: 'v1', vector: '[1]')
+    result = job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: ->(_b) { [9] })
+    assert_equal :discarded, result
+    assert_equal '[1]', Knowledge::Embedding.find_by!(document_id: doc.id, version: 'v1').vector
+  end
+
+  def test_stores_distinct_embedding_versions
+    doc = document
+    assert_equal :stored, job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: ->(_b) { [1] })
+    assert_equal :stored, job.call(document_id: doc.id, tenant_id: 'a', version: 'v2', provider: ->(_b) { [2] })
+    assert_equal 2, Knowledge::Embedding.count
+  end
+
+  def test_provider_errors_propagate_without_writing
+    doc = document
+    assert_raises(RuntimeError) do
+      job.call(document_id: doc.id, tenant_id: 'a', version: 'v1', provider: ->(_b) { raise 'provider failed' })
+    end
+    assert_equal 0, Knowledge::Embedding.count
+  end
+end
