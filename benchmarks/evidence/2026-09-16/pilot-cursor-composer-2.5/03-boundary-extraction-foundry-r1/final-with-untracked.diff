+
+require_relative 'test_helper'
+
+class KnowledgeBoundaryTest < BenchmarkTest
+  def test_documents_delivery_uses_catalog_not_document_model
+    source = File.read(Rails.root.join('app/controllers/documents_controller.rb'))
+
+    refute_includes source, 'Knowledge::Document'
+    assert_includes source, 'Knowledge::Catalog.list'
+  end
+end
