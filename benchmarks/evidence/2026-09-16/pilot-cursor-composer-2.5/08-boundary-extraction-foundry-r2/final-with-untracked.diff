diff --git a/test/knowledge_catalog_test.rb b/test/knowledge_catalog_test.rb
new file mode 100644
index 0000000..81145a7
--- /dev/null
+++ b/test/knowledge_catalog_test.rb
@@ -0,0 +1,37 @@
+# frozen_string_literal: true
+
+require_relative 'test_helper'
+
+class KnowledgeCatalogTest < BenchmarkTest
+  include Rack::Test::Methods
+
+  def app
+    Rails.application
+  end
+
+  def test_list_returns_published_documents_ordered_by_id
+    document(tenant: 'a', body: 'first', revision: 1)
+    document(tenant: 'a', body: 'second', revision: 1)
+    document(tenant: 'b', body: 'other tenant')
+    document(tenant: 'a', body: 'draft', published: false)
+
+    rows = Knowledge::Catalog.list(tenant_id: 'a')
+
+    ids = rows.map { |row| row.fetch('id') }
+    assert_equal ids.sort, ids
+    assert_equal 2, ids.size
+    rows.each do |row|
+      assert_equal %w[id tenant_id body revision].sort, row.keys.sort
+      assert_equal 'a', row.fetch('tenant_id')
+    end
+  end
+
+  def test_documents_delivery_uses_catalog_public_api
+    expected = document
+    get '/documents', {}, { 'HTTP_AUTHORIZATION' => 'tenant-a-token' }
+    catalog_rows = Knowledge::Catalog.list(tenant_id: 'a')
+
+    assert_equal catalog_rows, JSON.parse(last_response.body)
+    assert_equal catalog_rows.map { |row| row.fetch('id') }, [expected.id]
+  end
+end
