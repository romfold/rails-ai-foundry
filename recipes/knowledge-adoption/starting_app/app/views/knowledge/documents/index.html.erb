<h1>Knowledge documents</h1>
<%= form_with url: documents_path do |form| %>
  <%= form.text_field :title, placeholder: "Title" %>
  <%= form.text_area :body, placeholder: "Body" %>
  <%= form.submit "Create draft" %>
<% end %>
<% @documents.each do |document| %>
  <article><h2><%= document[:title] %></h2><p><%= document[:body] %></p>
    <p>Revision <%= document[:revision] %>: <%= document[:status] %></p>
  </article>
<% end %>
